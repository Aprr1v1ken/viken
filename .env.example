# Salin berkas ini menjadi ".env" lalu sesuaikan isinya.
# Berkas .env tidak boleh di-commit ke Git.

# Port server produksi (bawaan 3000)
PORT=3000

# Kunci penandatangan token sesi — WAJIB diganti dengan teks acak yang panjang
# sebelum situs dipakai secara resmi, contoh: hasil dari `openssl rand -hex 32`
SESSION_SECRET=ganti-dengan-teks-acak-yang-panjang

# (Opsional) lokasi berkas database SQLite.
# Bawaan: ./sysjeger.sqlite pada folder proyek.
#SYSJEGER_DB_PATH=/var/data/sysjeger/sysjeger.sqlite

# (Opsional) batasi domain yang boleh menyematkan situs ini sebagai iframe.
# Bawaan: tidak dibatasi (diperlukan agar pratinjau semacam Arena Live
# Preview dapat menampilkan situs; bila dibatasi sembarangan, pratinjau
# hanya akan menampilkan layar putih). Untuk deployment resmi, contoh:
#FRAME_ANCESTORS="'self'"

# (Opsional) log akses server: kosongkan/biarkan untuk menyala,
# atur menjadi off untuk mematikan.
#ACCESS_LOG=off

# (Opsional) folder penyimpanan foto jemaat yang diunggah.
# Bawaan: ./uploads pada folder proyek. Folder ini wajib ikut dicadangkan
# bersama berkas database agar foto pada kartu anggota tidak hilang.
#SYSJEGER_UPLOADS_DIR=/var/data/sysjeger/uploads
