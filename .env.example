# Salin berkas ini menjadi ".env" lalu sesuaikan isinya.
# Berkas .env tidak boleh di-commit ke Git.

# Port server produksi (bawaan 3000)
PORT=3000

# Kunci penandatangan token sesi — WAJIB diganti dengan teks acak yang panjang
# sebelum situs dipakai secara resmi, contoh: hasil dari `openssl rand -hex 32`
SESSION_SECRET=ganti-dengan-teks-acak-yang-panjang

# (Opsional) lokasi berkas database SQLite.
# Bawaan: ./sysjeger.sqlite pada folder proyek.
#SYSJEGER_DB_PATH=/var/data/sysjeger/sysjeger.sqlite
